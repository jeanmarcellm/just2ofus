# Supabase > Project Settings > API Keys (Data API URL + publishable key).
# The publishable key is safe in the browser; security comes from RLS.
# Never put the secret / service_role key here: NEXT_PUBLIC_* ends up in the bundle.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public web URL used in invite links and email confirmation redirects.
# Required for the native apps, whose origin is capacitor://localhost.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
